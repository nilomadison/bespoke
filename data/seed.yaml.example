# Copy this to data/seed.yaml and fill in your real career data.
# Run: python -m src.db.seed
# Safe to re-run — upserts, does not duplicate.

profile:
  full_name: "Jane Smith"
  email: "jane@example.com"
  phone: "+1 (555) 000-0000"
  location: "San Francisco, CA"
  linkedin_url: "https://linkedin.com/in/janesmith"
  github_url: "https://github.com/janesmith"
  portfolio_url: ""
  baseline_summary: >
    Software engineer with 8 years of experience building scalable backend systems
    and developer tools. Passionate about developer experience and observability.

skills:
  - name: Python
    category: Languages
  - name: Go
    category: Languages
  - name: TypeScript
    category: Languages
  - name: PostgreSQL
    category: Databases
  - name: Redis
    category: Databases
  - name: FastAPI
    category: Frameworks
  - name: Docker
    category: Infrastructure
  - name: Kubernetes
    category: Infrastructure
  - name: AWS
    category: Cloud

jobs:
  - title: "Senior Software Engineer"
    company: "Acme Corp"
    location: "San Francisco, CA"
    start_date: "2021-03-01"
    end_date: null  # null = current role
    employment_type: "full_time"
    is_technical: true
    sort_order: 0
    summary: >
      Lead engineer on the platform team, responsible for the core API and
      internal developer tooling serving 50+ engineers.
    achievements:
      - text: "Redesigned the authentication service to support OAuth 2.0 and SAML SSO"
        metric: "Reduced login-related support tickets by 60%"
        impact_tags: [security, scale, reliability]
        prominence: 5
      - text: "Built an internal feature-flag service used by all product teams"
        metric: "Enabled 3x faster A/B test iteration cycle"
        impact_tags: [developer_experience, scale]
        prominence: 4
      - text: "Mentored 3 junior engineers; two were promoted within 12 months"
        impact_tags: [leadership, mentorship]
        prominence: 3
    skills:
      - { name: Python, proficiency: "advanced", years_used: 4 }
      - { name: PostgreSQL, proficiency: "advanced", years_used: 4 }
      - { name: Kubernetes, proficiency: "intermediate", years_used: 2 }
      - { name: AWS, proficiency: "intermediate", years_used: 3 }

  - title: "Software Engineer"
    company: "StartupXYZ"
    location: "Remote"
    start_date: "2018-06-01"
    end_date: "2021-02-28"
    employment_type: "full_time"
    is_technical: true
    sort_order: 1
    summary: "Full-stack engineer on a 5-person team, early employee #12."
    achievements:
      - text: "Built the real-time notifications system from scratch using WebSockets"
        impact_tags: [scale, reliability, full_stack]
        prominence: 4
      - text: "Migrated the monolith to a microservices architecture"
        metric: "Reduced average deploy time from 45 minutes to 8 minutes"
        impact_tags: [devops, scale, architecture]
        prominence: 5
    skills:
      - { name: Python, proficiency: "intermediate", years_used: 3 }
      - { name: TypeScript, proficiency: "intermediate", years_used: 2 }
      - { name: Docker, proficiency: "intermediate", years_used: 3 }

education:
  - institution: "University of California, Berkeley"
    degree: "B.S."
    field: "Computer Science"
    location: "Berkeley, CA"
    start_date: "2014-08-01"
    end_date: "2018-05-15"
    is_in_progress: false
    gpa: 3.8
    honors: "Magna Cum Laude"

  # In-progress degree: leave end_date null, set is_in_progress: true,
  # and set expected_end_date to your projected graduation.
  - institution: "Some University"
    degree: "M.S."
    field: "Computer Science"
    location: "Online"
    start_date: "2024-09-01"
    end_date: null
    expected_end_date: "2026-06-01"
    is_in_progress: true
    gpa: null
    honors: null

certifications:
  - name: "AWS Certified Solutions Architect – Associate"
    issuer: "Amazon Web Services"
    issue_date: "2022-06-01"
    expiry_date: "2025-06-01"
    credential_id: "ABC123"
    credential_url: ""
    notes: "Earned during the platform migration; covers SAA-C03 exam scope."

projects:
  - name: "Bespoke"
    summary: "Local-first career database and LLM-powered resume tailoring tool"
    description: >
      FastAPI + SQLite app that treats your career history as structured data and uses
      a two-stage LLM pipeline to generate tailored resumes. No fabrication — the LLM
      selects and rephrases real achievements, never invents.
    repo_url: "https://github.com/janesmith/bespoke"
    live_url: ""
    start_date: "2025-01-01"
    end_date: null
    is_active: true
    prominence: 5

  # Optional: pin a project to a specific job by (company, title). The job
  # must exist in the `jobs:` section above. Useful when a project shipped
  # under a particular role.
  - name: "Internal Feature Flag Service"
    summary: "Flag-as-a-service used by all product teams"
    description: >
      Internal Python/FastAPI service for runtime feature flags, used to coordinate
      A/B tests across product teams. See achievement under Acme Corp.
    repo_url: ""
    live_url: ""
    start_date: "2022-04-01"
    end_date: null
    is_active: true
    prominence: 4
    job: { company: "Acme Corp", title: "Senior Software Engineer" }
